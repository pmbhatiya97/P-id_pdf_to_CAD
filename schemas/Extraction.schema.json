          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "tile_id": {
          "title": "Tile Id",
          "type": "string"
        },
        "source_agent": {
